{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aku.local/schemas/service-config.schema.json",
  "title": "AkuSupervisor service configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "control", "services"],
  "properties": {
    "version": {
      "const": 1
    },
    "control": {
      "$ref": "#/$defs/control"
    },
    "observability": {
      "$ref": "#/$defs/observability"
    },
    "cooperativeActions": {
      "$ref": "#/$defs/cooperativeActions"
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "$defs": {
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consoleEvents": {
          "type": "string",
          "enum": ["off", "lifecycle", "verbose"],
          "default": "lifecycle"
        }
      },
      "default": {
        "consoleEvents": "lifecycle"
      }
    },
    "cooperativeActions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "akuBridgeReload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sidecarOrigin", "timeoutMs", "pollIntervalMs"],
          "properties": {
            "sidecarOrigin": {
              "type": "string",
              "pattern": "^http://(?:127\\.0\\.0\\.1|\\[::1\\]):[0-9]+$"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 60000
            },
            "pollIntervalMs": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "default": {}
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "tokenFile"],
      "properties": {
        "host": {
          "const": "127.0.0.1"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "tokenFile": {
          "type": "string",
          "pattern": "^\\.runtime[\\\\/][^/\\\\]+(?:[\\\\/][^/\\\\]+)*$"
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "allowedOrigins": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "default": []
            }
          },
          "default": {}
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "cwd",
        "command",
        "health",
        "restartPolicy",
        "shutdownGraceMs"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "health": {
          "$ref": "#/$defs/health"
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "uniqueItems": true,
          "default": []
        },
        "restartPolicy": {
          "enum": ["manual", "on-failure"]
        },
        "shutdownGraceMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "health": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "const": "process"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "host",
            "port",
            "timeoutMs",
            "startupDeadlineMs"
          ],
          "properties": {
            "type": {
              "const": "tcp-connect"
            },
            "host": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "startupDeadlineMs": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "url",
            "expectedStatus",
            "timeoutMs",
            "startupDeadlineMs"
          ],
          "properties": {
            "type": {
              "const": "http-status"
            },
            "url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "expectedStatus": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "startupDeadlineMs": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "url",
            "timeoutMs",
            "startupDeadlineMs",
            "expect"
          ],
          "properties": {
            "type": {
              "const": "http-json"
            },
            "url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            },
            "startupDeadlineMs": {
              "type": "integer",
              "minimum": 1
            },
            "expect": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": ["string", "number", "integer", "boolean", "null"]
              }
            }
          }
        }
      ]
    }
  }
}
