{
  "version": 1,
  "control": {
    "host": "127.0.0.1",
    "port": 47830,
    "tokenFile": ".runtime/geofu-be/control-token",
    "mcp": {
      "enabled": true,
      "allowedOrigins": []
    }
  },
  "services": {
    "geofu-be": {
      "label": "Geofu Backend",
      "cwd": "C:\\WorkspaceCodex\\GeofuWorkspace\\Geofu_be",
      "command": "C:\\WorkspaceCodex\\GeofuWorkspace\\Geofu_be\\output\\geofu-server.exe",
      "args": [
        "--host",
        "127.0.0.1",
        "--port",
        "8765",
        "--package-root",
        "output\\package_server"
      ],
      "environment": {},
      "health": {
        "type": "http-json",
        "url": "http://127.0.0.1:8765/catalog.json",
        "timeoutMs": 5000,
        "startupDeadlineMs": 30000,
        "expect": {
          "schemaVersion": 1
        }
      },
      "ports": [
        8765
      ],
      "restartPolicy": "manual",
      "shutdownGraceMs": 5000
    }
  }
