{
  "version": 1,
  "control": {
    "host": "127.0.0.1",
    "port": 47820,
    "tokenFile": ".runtime/control-token",
    "mcp": {
      "enabled": true,
      "allowedOrigins": []
    }
  },
  "observability": {
    "consoleEvents": "lifecycle"
  },
  "cooperativeActions": {
    "akuBridgeReload": {
      "sidecarOrigin": "http://127.0.0.1:47821",
      "timeoutMs": 20000,
      "pollIntervalMs": 250
    }
  },
  "services": {
    "akusidecar": {
      "label": "AkuSidecar",
      "cwd": "C:\\WorkspaceCodex\\AkuWorkspace\\AkuSidecar",
      "command": "C:\\nvm4w\\nodejs\\npm.cmd",
      "args": [
        "run",
        "dev"
      ],
      "environment": {},
      "health": {
        "type": "http-json",
        "url": "http://127.0.0.1:47821/api/health",
        "timeoutMs": 5000,
        "startupDeadlineMs": 20000,
        "expect": {
          "status": "ok",
          "bridgeContractVersion": "aku-browser.bridge.v1",
          "provider": "codex-sdk"
        }
      },
      "ports": [
        47821
      ],
      "restartPolicy": "manual",
      "shutdownGraceMs": 3000
    },
    "geofu-be": {
      "label": "Geofu Backend",
      "cwd": "C:\\WorkspaceCodex\\GeofuWorkspace\\Geofu_be",
      "command": "C:\\WorkspaceCodex\\GeofuWorkspace\\Geofu_be\\output\\geofu-server.exe",
      "args": [
        "--host",
        "127.0.0.1",
        "--port",
        "8765",
        "--package-root",
        "output\\package_server"
      ],
      "environment": {},
      "health": {
        "type": "http-json",
        "url": "http://127.0.0.1:8765/catalog.json",
        "timeoutMs": 5000,
        "startupDeadlineMs": 30000,
        "expect": {
          "schemaVersion": 1
        }
      },
      "ports": [
        8765
      ],
      "restartPolicy": "manual",
      "shutdownGraceMs": 5000
    },
    "geofu-plugin": {
      "label": "Geofu Plugin Dev Server",
      "cwd": "C:\\WorkspaceCodex\\GeofuWorkspace\\Geofu",
      "command": "C:\\nvm4w\\nodejs\\npm.cmd",
      "args": [
        "run",
        "dev"
      ],
      "environment": {},
      "health": {
        "type": "http-json",
        "url": "http://127.0.0.1:8766/geofu/plugin.json",
        "timeoutMs": 5000,
        "startupDeadlineMs": 30000,
        "expect": {
          "id": "geofu"
        }
      },
      "ports": [
        8766
      ],
      "restartPolicy": "manual",
      "shutdownGraceMs": 5000
    },
    "geolibre": {
      "label": "GeoLibre Geofu Unlocked Dev",
      "cwd": "C:\\WorkspaceCodex\\GeofuWorkspace\\GeoLibre",
      "command": "C:\\nvm4w\\nodejs\\npm.cmd",
      "args": [
        "run",
        "geofu:dev"
      ],
      "environment": {
        "GEOLIBRE_DEV_PORT": "6060"
      },
      "health": {
        "type": "http-status",
        "url": "http://127.0.0.1:6060/favicon.png",
        "expectedStatus": 200,
        "timeoutMs": 5000,
        "startupDeadlineMs": 120000
      },
      "ports": [
        6060
      ],
      "restartPolicy": "manual",
      "shutdownGraceMs": 5000
    },
    "geolibre-locked": {
      "label": "GeoLibre Geofu Locked QA",
      "cwd": "C:\\WorkspaceCodex\\GeofuWorkspace\\GeoLibre",
      "command": "C:\\nvm4w\\nodejs\\npm.cmd",
      "args": [
        "run",
        "geofu:locked-dev"
      ],
      "environment": {
        "GEOLIBRE_DEV_PORT": "6061"
      },
      "health": {
        "type": "http-status",
        "url": "http://127.0.0.1:6061/favicon.png",
        "expectedStatus": 200,
        "timeoutMs": 5000,
        "startupDeadlineMs": 120000
      },
      "ports": [
        6061
      ],
      "restartPolicy": "manual",
      "shutdownGraceMs": 5000
    }
  }
}
